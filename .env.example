# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Apify (Step 2) ---
# Get from https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Instagram accounts (Step 2) ---
IG_USERNAME=builtbyruturaj
# Comma-separated, no spaces preferred
IG_COMPETITORS=ai.noobstoninjas,vaibhavsisinty,jerrythewebdev,gayatri.tech,web.love.ed
# How many recent posts to pull per account
IG_POSTS_LIMIT=30

# --- Telegram (Step 4) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (we'll find this in Step 4)
TELEGRAM_CHAT_ID=

# --- Scheduling (Step 5) ---
# Cron for `npm run schedule`. Default is daily 09:00; example below = Mon & Thu.
REPORT_CRON=0 9 * * 1,4
